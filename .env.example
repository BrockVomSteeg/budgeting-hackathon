# Copy to .env.local (gitignored). In prod, set these in Vercel → Settings → Environment Variables.
# Leave blank to run in mock mode.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Live voice agent (see AGENT_SETUP.md)
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_OVERRIDE=
# Optional model override (default claude-haiku-5-5)
ANTHROPIC_MODEL=
# Fish Audio voice (used before ElevenLabs if set)
FISH_API_KEY=
# Voice model ID from fish.audio (default for all personas)
FISH_VOICE_ID=
# Optional per persona: FISH_VOICE_SERGEANT, FISH_VOICE_GRANDMA, FISH_VOICE_CHEF, FISH_VOICE_BESTIE
FISH_MODEL=
