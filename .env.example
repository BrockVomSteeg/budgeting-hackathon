# Copy to .env.local (gitignored). In prod, set these in Vercel → Settings → Environment Variables.
# Leave blank to run in mock mode.
ANTHROPIC_API_KEY=
# Optional model override (default claude-haiku-5-5)
ANTHROPIC_MODEL=
# Fish Audio: Gordon's voice (/api/speak) AND speech-to-text (/api/transcribe). Needs API credit, separate from platform credit.
# Blank = browser recognizer + ElevenLabs/browser voice.
FISH_API_KEY=
# Fallback Fish voice model ID from fish.audio (Gordon's own voice is fishVoiceId in lib/personas.ts)
FISH_VOICE_ID=
# Optional per-persona override: FISH_VOICE_CHEF (Gordon is the only persona)
# Optional Fish TTS model (default s2.1-pro)
FISH_MODEL=
# Optional secret that signs lines so /api/speak only voices what /api/ask said
# (falls back to ANTHROPIC_API_KEY / FISH_API_KEY). Set it to a long random string in prod.
SPEAK_SECRET=
# ElevenLabs: TTS fallback when Fish fails or is unset
ELEVENLABS_API_KEY=
# Optional live voice agent, not wired into the UI (see AGENT_SETUP.md)
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_OVERRIDE=
